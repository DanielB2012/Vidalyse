{
  "name": "vidalyse",
  "version": "0.1.4",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "postbuild:standalone": "node electron/scripts/assemble-standalone.mjs",
    "electron:dev": "npm run build && npm run postbuild:standalone && electron electron/main.js",
    "dist": "npm run build && npm run postbuild:standalone && electron-builder --win --publish never",
    "release": "npm run build && npm run postbuild:standalone && electron-builder --win --publish always"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "@auth/prisma-adapter": "^2.11.3",
    "@google/genai": "^2.19.0",
    "@huggingface/transformers": "^4.2.0",
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "googleapis": "^176.0.0",
    "lucide-react": "^1.37.0",
    "next": "16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "electron-updater": "^6.6.2",
    "youtube-dl-exec": "^3.1.13"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "electron": "^44.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "ffmpeg-static@5.3.0": true,
    "youtube-dl-exec@3.1.13": true,
    "onnxruntime-node@1.24.3": true,
    "sharp@0.35.4": true
  }
}
